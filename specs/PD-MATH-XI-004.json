  "hypotheses": [
    {
      "lhs": "sin(alpha)+sin(beta)",
      "rhs": "a",
      "quote": "sin α + sin β = a"
    },
    {
      "lhs": "cos(alpha)+cos(beta)",
      "rhs": "b",
      "quote": "cos α + cos β = b"
